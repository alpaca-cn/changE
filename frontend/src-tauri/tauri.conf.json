{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "changE",
  "version": "0.2.3",
  "identifier": "com.change.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm check:release-resources && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "changE",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/change-backend.jar": "change-backend.jar",
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMzZFQjQzRkZFRTNDQjUKUldTMVBPNy9RK3MyMEVSTDJNOEEvRllObXR6ejR5YUFGU0VNTGc5MkJ0UkpVVVkxbnZQUUV1cWMK",
      "endpoints": [
        "https://change-release.oss-cn-beijing.aliyuncs.com/latest.json",
        "https://github.com/alpaca-cn/changE/releases/latest/download/latest.json"
      ]
    }
  }
}
